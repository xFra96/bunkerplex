# Impostazioni facoltative di FrancoPlex.
# Le raccolte e le cartelle dei video NON si scrivono qui: si scelgono
# dall'app: "Aggiungi raccolta" nel menu a sinistra.

# Lingua di locandine e trame.
TMDB_LANG=it-IT

# Ogni quanti minuti il server ricontrolla le cartelle.
SCAN_INTERVAL_MIN=30

# La chiave TMDB si inserisce dall'app (Impostazioni). In alternativa qui:
TMDB_API_KEY=

# Dove sta il catalogo (elenco film, schede, locandine, visti).
# Di solito non serve toccarlo: se la cartella "data" accanto a questo file
# contiene gia' un catalogo, viene usata quella (e' il caso di tutta la cartella
# FrancoPlex tenuta sul disco esterno). DATA_PATH serve solo quando FrancoPlex
# sta sul PC e il catalogo su un disco esterno: se su un altro PC il disco ha
# un'altra lettera, lo stesso percorso viene cercato da solo su tutti i dischi.
# Esempio: DATA_PATH=F:\PortableApps\FrancoPlex\data
DATA_PATH=
