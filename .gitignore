# Mai su GitHub: restano solo sul tuo disco.

# Catalogo (film, locandine, visti, chiave TMDB)
/data/
# Impostazioni di questo PC
/.env
/docker-compose.override.yml
# Chiave di firma dell'app per la TV e risultati della compilazione
/android/keystore/
/android/out/
*.jks
# L'APK compilato viaggia come allegato della release "app-tv", non nel codice
/apk/
# Accesso a GitHub e versione installata
/strumenti/github-token.txt
/strumenti/versione.json
# Scambio tra server e aiutante degli aggiornamenti (Agente.ps1)
/strumenti/agente.json
/strumenti/richiesta-aggiornamento.json
/strumenti/esito-aggiornamento.json
/strumenti/aggiornamento.log
/strumenti/*.nuovo

__pycache__/
*.pyc
.gradle/
/android/build/
/android/app/build/
/android/local.properties
.idea/
*.iml
.claude/
# Libreria Tailscale dell'app: la compila android/tsnet/build.sh
/android/app/libs/
# Configurazione Firebase dell'app (notifiche): la mette GitHub dal segreto GOOGLE_SERVICES_JSON
/android/app/google-services.json

# wrangler (pubblicazione del servizio account)
/cloud/.wrangler/
/cloud/node_modules/
/cloud/.dev.vars

