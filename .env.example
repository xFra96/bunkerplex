# Impostazioni facoltative di BunkerPlex.
# Le raccolte e le cartelle dei video NON si scrivono qui: si scelgono
# dall'app: "Aggiungi raccolta" nel menu a sinistra.

# Lingua di locandine e trame.
TMDB_LANG=it-IT

# Ogni quanti minuti il server ricontrolla le cartelle.
SCAN_INTERVAL_MIN=30

# La chiave TMDB si inserisce dall'app (Impostazioni) e resta nel tuo account:
# la ritrovi su ogni PC dove entri. Questa sotto vale solo per questo PC e
# solo se l'account non ne ha una.
TMDB_API_KEY=

# Servizio account (login, impostazioni e visti sincronizzati tra i PC).
# Di solito va lasciato vuoto: l'indirizzo arriva con gli aggiornamenti in
# server/cloud.json. Scrivilo qui solo per usare un servizio tuo diverso.
BUNKERPLEX_CLOUD=
